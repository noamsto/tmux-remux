#!/usr/bin/env bash
#
# Builds the scene demo/undo.tape opens on, against a detached throwaway tmux
# server. The host tmux.conf loads, so the recording carries the real theme,
# statusline and fish panes; only the parts that would make the demo lie about
# which binary runs are replaced — the host's own remux wiring points at an
# installed tmux-remux, not the one under test.
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

BIN="$PWD/demo/bin/tmux-remux"
if [ ! -x "$BIN" ]; then
  printf 'demo/setup: build it first: go build -o demo/bin/tmux-remux ./cmd/tmux-remux\n' >&2
  exit 1
fi

tm() { tmux -L vhs "$@"; }

# Every tmux call here is explicitly -L vhs, but tmux-remux itself picks its
# server up from $TMUX: inherited from an outer tmux, it would snapshot the
# host's server instead and undo would find nothing to restore.
unset TMUX

# Isolated so the demo neither reads nor writes the real snapshot store.
export XDG_DATA_HOME=/tmp/remux-demo
rm -rf /tmp/remux-demo /tmp/agent-work.step
tm kill-server 2>/dev/null || true
# kill-server returns before the server is gone; starting the new one against a
# socket that is still draining fails with "server exited unexpectedly".
for _ in $(seq 50); do
  tm list-sessions >/dev/null 2>&1 || break
  sleep 0.1
done

# $SHELL is bash here, so fish has to be asked for by name.
FISH="$(command -v fish)"
# Sized to the terminal undo.tape records at (95x26, less the theme's two status
# rows). A detached server otherwise defaults to 80x24 and the attach resizes it,
# which makes fish redraw its prompt and leaves the earlier, wider renderings
# behind as truncated junk lines.
tm new-session -d -x 95 -y 24 -s demo -c "$PWD" "$FISH"
tm set -g default-shell "$FISH"
tm set -g prefix C-b

# The real plugin wiring, so the recording exercises the binary just built.
"$BIN" triggers --auto-restore=off | tm source-file -

# Key-press badge, pinned to the bottom row as a borderless popup. A tmux
# message is not an option: it can only render on a status line, and those all
# sit wherever status-position puts them — the top, where the host theme's
# statusline belongs. -y is deliberately past the last row so tmux clamps it to
# the bottom whatever the client height. The host theme's colours are resolved
# here, so -s gets literal values and never has to expand a format.
PEACH="$(tm show -gqv @thm_peach)"
THMBG="$(tm show -gqv @thm_bg)"
badge="display-popup -B -s 'bg=$PEACH,fg=$THMBG' -w 30 -h 1 -x C -y 999 -E"

# prefix+x is stock tmux's `confirm-before kill-pane`; the demo kills outright so
# the recording doesn't hinge on a typed "y". Each sequence is one argument: a
# bare `;` would separate commands for the outer tmux invocation instead, firing
# kill-pane on the spot.
#
# The action is deferred behind the badge rather than firing with it, so the
# recording shows the key, then the key taking effect. -b keeps the sleep off
# the server's command queue; #{pane_id} pins the pane that was active at the
# press, since the sleep outlives the key's own target.
tm bind x "$badge \"echo '  C-b x  →  kill-pane' ; sleep 1.5\" ; run-shell -b \"sleep 1.2 ; tmux kill-pane -t '#{pane_id}'\""
tm bind u "$badge \"echo '  C-b u  →  remux undo' ; sleep 1.5\" ; run-shell -b \"sleep 1.2 ; $BIN undo --pop --session='#{session_name}'\""

# The agent runs as the pane's command rather than keys typed into a shell:
# send-keys races the shell's startup and the keystrokes get dropped.
# Panes stacked rather than side by side: killing the agent's pane and restoring
# it then changes the survivor's height, never its width, so fish never re-wraps
# and reprints its prompt. Side by side, the 47-column survivor widened to 95 on
# the kill and back again on the undo, leaving three truncated copies of the
# prompt stacked up by the end of the recording.
tm split-window -v -t demo -c "$PWD" "$PWD/demo/agent-work"
# after-split-window saves in the background, and that save can land after an
# immediate explicit one — leaving a newest snapshot that predates the stamp,
# which undo would then restore a pane without the agent from.
sleep 2
tm set -p -t demo @remux_relaunch "$PWD/demo/agent-work"
tm run-shell "$BIN save"
